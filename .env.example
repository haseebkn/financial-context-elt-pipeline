# ==============================================================================
# Financial & Communication Context Engine - Environment Configuration Template
# Copy this file to '.env' in the project root and fill in your own credentials.
# All variables are read via config/settings.py (config/pipeline_config.yaml
# supplies non-secret defaults only).
# ==============================================================================

# General Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Storage (landing zone for raw extractor output)
# Relative to the repo root — leave as-is unless you have a reason to change it.
RAW_DATA_DIR=raw_data

# Alpaca Markets API Credentials (Paper/Sandbox)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_IS_PAPER=True

# Plaid API Credentials (Sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_ACCESS_TOKEN=

# Google Calendar API Credentials
# Place credentials.json in the project root for the initial OAuth login flow.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# AWS S3 Cloud Integration (optional — state backup)
# Leave AWS_S3_BUCKET empty to run fully offline/local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=

# Internal retrieval service (vector_prep/retrieval_service.py), called by
# the Node agent service (agent/) — never exposed publicly. Generate a
# random token and set the same value in agent/.env's RETRIEVAL_SERVICE_TOKEN.
RETRIEVAL_SERVICE_TOKEN=
RETRIEVAL_SERVICE_HOST=127.0.0.1
RETRIEVAL_SERVICE_PORT=8100
