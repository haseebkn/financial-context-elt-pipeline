# Copy to .env in this directory (or export these before running).

# Required — Claude API key.
ANTHROPIC_API_KEY=

# Model the agent loop uses.
AGENT_MODEL=claude-opus-5

# Used to resolve relative dates such as "last month".
USER_TIME_ZONE=America/St_Johns

# Port the agent HTTP service listens on.
PORT=8787

# Path to the DuckDB warehouse file, relative to this directory.
DUCKDB_PATH=../financial_engine.db

# The internal retrieval service (vector_prep/retrieval_service.py). The
# token here must match RETRIEVAL_SERVICE_TOKEN in the repo root .env.
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8100
RETRIEVAL_SERVICE_TOKEN=

# Agent loop bounds.
MAX_TOOL_ITERATIONS=8
TASK_BUDGET_TOKENS=64000

LOG_LEVEL=info
