{
  "name": "financial-context-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/TypeScript agent service — tool-using Claude agent over the financial context warehouse.",
  "exports": {
    "./streaming-types": {
      "types": "./src/streaming-types.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:pr": "tsx evals/run.ts --subset 12 --gate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@duckdb/node-api": "^1.4.1-alpha.15",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.14",
    "node-sql-parser": "^5.3.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
